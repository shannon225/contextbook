<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>maccoss</groupId>
	<artifactId>encyclopedia</artifactId>
	<version>0.5.5-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>encyclopedia</name>
	<url>http://maven.apache.org</url>

	<properties>
		<!--
		The name of the produced executable JAR.

		If this is set to ${build.finalName} (which defaults
		to ${artifactId}-${version}), then the executable
		JAR will replace the one produced by the maven-jar-plugin
		and will be deployed as the result of this build.

		Otherwise, the executable jar is created at target/${targetName}
		and is not attached as a maven artifact (the current behavior).

		To attach both JARs to the build, you must reconfigure maven-shade-plugin
		to attach the executable JAR using <shadedArtifactAttached> and <shadedClassifierName>
		in its configuration below.
		-->
		
		<phosphoTargetName>thesaurus-${version}-executable</phosphoTargetName>
		<phosphoBuildTarget>edu.washington.gs.maccoss.encyclopedia.Thesaurus</phosphoBuildTarget>

		<xcordiaTargetName>xcordia-${version}-executable</xcordiaTargetName>
		<xcordiaBuildTarget>edu.washington.gs.maccoss.encyclopedia.XCorDIA</xcordiaBuildTarget>

		<walnutTargetName>walnut-${version}-executable</walnutTargetName>
		<walnutBuildTarget>edu.washington.gs.maccoss.encyclopedia.Walnut</walnutBuildTarget>

		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<repositories>
		<repository>
			<id>ebi-repo</id>
			<name>The EBI Maven 2 repository</name>
			<url>http://www.ebi.ac.uk/~maven/m2repo</url>
			<releases>
				<enabled>true</enabled>
			</releases>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>
		<repository>
			<id>jzy3d-releases</id>
			<name>Jzy3d Snapshots</name>
			<url>http://maven.jzy3d.org/releases</url>
			<releases>
				<enabled>true</enabled>
			</releases>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>
	</repositories>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<id>shade-phospho</id>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<finalName>${phosphoTargetName}</finalName>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>${phosphoBuildTarget}</mainClass>
								</transformer>
							</transformers>
						</configuration>
					</execution>
					<execution>
						<id>shade-encyclopedia</id>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<finalName>${encyclopediaTargetName}</finalName>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>${encyclopediaBuildTarget}</mainClass>
								</transformer>
							</transformers>
						</configuration>
					</execution>
					<execution>
						<id>shade-xcordia</id>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<finalName>${xcordiaTargetName}</finalName>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>${xcordiaBuildTarget}</mainClass>
								</transformer>
							</transformers>
						</configuration>
					</execution>
					<execution>
						<id>shade-walnut</id>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<finalName>${walnutTargetName}</finalName>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>${walnutBuildTarget}</mainClass>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<dependencies>
	<dependency>
		<groupId>org.apache.commons</groupId>
		<artifactId>commons-math3</artifactId>
		<version>3.6</version>
	</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>3.8.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>uk.ac.ebi.jmzml</groupId>
			<artifactId>jmzml</artifactId>
			<version>1.6.7</version>
		</dependency>
		<dependency>
			<groupId>org.xerial</groupId>
			<artifactId>sqlite-jdbc</artifactId>
			<version>3.8.11.2</version>
		</dependency>
		<dependency>
			<groupId>net.sf.trove4j</groupId>
			<artifactId>trove4j</artifactId>
			<version>3.0.3</version>
		</dependency>
		<dependency>
			<groupId>com.google.guava</groupId>
			<artifactId>guava</artifactId>
			<version>18.0</version>
		</dependency>
		<dependency>
			<groupId>org.jfree</groupId>
			<artifactId>jfreechart</artifactId>
			<version>1.0.19</version>
		</dependency>
		<dependency>
    		<groupId>org.jfree</groupId>
   	 		<artifactId>jfreesvg</artifactId>
    		<version>3.2</version>
		</dependency>
		<dependency>
			<groupId>com.itextpdf</groupId>
			<artifactId>itextpdf</artifactId>
			<version>5.5.8</version>
		</dependency>
		<dependency>
			<groupId>org.jzy3d</groupId>
			<artifactId>jzy3d-api</artifactId>
			<version>0.9.1</version>
		</dependency>
	</dependencies>
</project>
