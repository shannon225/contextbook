<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>maccoss</groupId>
	<artifactId>encyclopedia</artifactId>
	<version>1.2.2</version>
	<packaging>jar</packaging>

	<name>encyclopedia</name>
	<url>http://maven.apache.org</url>

	<properties>
		<!--
		The name of the produced executable JAR.

		If this is set to ${build.finalName} (which defaults
		to ${artifactId}-${version}), then the executable
		JAR will replace the one produced by the maven-jar-plugin
		and will be deployed as the result of this build.

		Otherwise, the executable jar is created at target/${targetName}
		and is not attached as a maven artifact (the current behavior).

		To attach both JARs to the build, you must reconfigure maven-shade-plugin
		to attach the executable JAR using <shadedArtifactAttached> and <shadedClassifierName>
		in its configuration below.
		-->
		<globalTargetName>encyclopedia-${version}-global</globalTargetName>
		<globalBuildTarget>edu.washington.gs.maccoss.encyclopedia.Main</globalBuildTarget>
		<buildGlobal>false</buildGlobal>

		<encyclopediaTargetName>encyclopedia-${version}-executable</encyclopediaTargetName>
		<encyclopediaBuildTarget>edu.washington.gs.maccoss.encyclopedia.Encyclopedia</encyclopediaBuildTarget>

		<phosphoTargetName>thesaurus-${version}-executable</phosphoTargetName>
		<phosphoBuildTarget>edu.washington.gs.maccoss.encyclopedia.Thesaurus</phosphoBuildTarget>

		<xcordiaTargetName>xcordia-${version}-executable</xcordiaTargetName>
		<xcordiaBuildTarget>edu.washington.gs.maccoss.encyclopedia.XCorDIA</xcordiaBuildTarget>

		<walnutTargetName>walnut-${version}-executable</walnutTargetName>
		<walnutBuildTarget>edu.washington.gs.maccoss.encyclopedia.Walnut</walnutBuildTarget>

		<!--
		By default, skip failsafe integration tests.
		Reenable by running mvn with `-DskipITs=false`
		-->
		<skipITs>true</skipITs>

		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<repositories>
		<repository>
		  <id>nexus-ebi-release-repo</id>
		  <url>http://www.ebi.ac.uk/Tools/maven/repos/content/groups/ebi-repo/</url>
		 </repository>
		<repository>
			<id>ebi-repo</id>
			<name>The EBI Maven 2 repository</name>
			<url>http://www.ebi.ac.uk/~maven/m2repo</url>
			<releases>
				<enabled>true</enabled>
			</releases>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>
		<repository>
			<id>jzy3d-releases</id>
			<name>Jzy3d Snapshots</name>
			<url>http://maven.jzy3d.org/releases</url>
			<releases>
				<enabled>true</enabled>
			</releases>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>
		<repository>
			<id>genesis-maven2-repository</id>
			<name>Genesis maven2 repository</name>
			<url>http://genesis.UGent.be/maven2</url>
			<layout>default</layout>
		</repository>
		<repository>
			<id>jitpack.io</id>
			<url>https://jitpack.io</url>
		</repository>
		<!--  Attempt to override the repository provided
		      by the xxindex POM (required for cpdetector).
		      Using a non-HTTPS URL causes an error. -->
		<repository>
			<id>sammoa-group</id>
			<url>https://maven.nuiton.org/nexus/content/repositories/sammoa-group/</url>
		</repository>
	</repositories>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
				</configuration>
			</plugin>
			<plugin>
				<!-- Allows us to properly fetch artifact version programmatically in code.
					We do this to save program information in files creates by this artifact.
					Usage:
					Class k = ...
					k.getPackage().getImplementationVersion() -> {$version}
				-->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
							<addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<version>3.0.0-M5</version>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
						<configuration>
							<skipITs>${skipITs}</skipITs>
							<skipTests>false</skipTests> <!-- ignore setting to skip UTs -->
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- build with `mvn -DbuildJars ...` to create ALL executable JARs -->
		<profile>
			<!-- build with `mvn -PbuildGlobal ...` to create the global executable JAR -->
			<id>buildGlobal</id>
			<activation>
				<property>
					<name>buildJars</name>
					<value>true</value>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-shade-plugin</artifactId>
						<executions>
							<execution>
								<id>shade-global</id>
								<phase>package</phase>
								<goals>
									<goal>shade</goal>
								</goals>
								<configuration>
									<filters>
										<filter>
											<artifact>*:*</artifact>
											<excludes>
												<exclude>META-INF/*.SF</exclude>
												<exclude>META-INF/*.DSA</exclude>
												<exclude>META-INF/*.RSA</exclude>
											</excludes>
										</filter>
									</filters>
									<finalName>${globalTargetName}</finalName>
									<transformers>
										<transformer
												implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
											<mainClass>${globalBuildTarget}</mainClass>
										</transformer>
									</transformers>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<!-- build with `mvn -PbuildEncyclopedia ...` to create the encyclopedia executable JAR -->
			<id>buildEncyclopedia</id>
			<activation>
				<property>
					<name>buildJars</name>
					<value>true</value>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-shade-plugin</artifactId>
						<executions>
							<execution>
								<id>shade-encyclopedia</id>
								<phase>package</phase>
								<goals>
									<goal>shade</goal>
								</goals>
								<configuration>
									<filters>
										<filter>
											<artifact>*:*</artifact>
											<excludes>
												<exclude>META-INF/*.SF</exclude>
												<exclude>META-INF/*.DSA</exclude>
												<exclude>META-INF/*.RSA</exclude>
											</excludes>
										</filter>
									</filters>
									<finalName>${encyclopediaTargetName}</finalName>
									<transformers>
										<transformer
												implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
											<mainClass>${encyclopediaBuildTarget}</mainClass>
										</transformer>
									</transformers>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<!-- build with `mvn -PbuildPhospho ...` to create the phospho executable JAR -->
			<id>buildPhospho</id>
			<activation>
				<property>
					<name>buildJars</name>
					<value>true</value>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-shade-plugin</artifactId>
						<executions>
							<execution>
								<id>shade-phospho</id>
								<phase>package</phase>
								<goals>
									<goal>shade</goal>
								</goals>
								<configuration>
									<filters>
										<filter>
											<artifact>*:*</artifact>
											<excludes>
												<exclude>META-INF/*.SF</exclude>
												<exclude>META-INF/*.DSA</exclude>
												<exclude>META-INF/*.RSA</exclude>
											</excludes>
										</filter>
									</filters>
									<finalName>${phosphoTargetName}</finalName>
									<transformers>
										<transformer
												implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
											<mainClass>${phosphoBuildTarget}</mainClass>
										</transformer>
									</transformers>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<!-- build with `mvn -PbuildXcordia ...` to create the xcordia executable JAR -->
			<id>buildXcordia</id>
			<activation>
				<property>
					<name>buildJars</name>
					<value>true</value>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-shade-plugin</artifactId>
						<executions>
							<execution>
								<id>shade-xcordia</id>
								<phase>package</phase>
								<goals>
									<goal>shade</goal>
								</goals>
								<configuration>
									<filters>
										<filter>
											<artifact>*:*</artifact>
											<excludes>
												<exclude>META-INF/*.SF</exclude>
												<exclude>META-INF/*.DSA</exclude>
												<exclude>META-INF/*.RSA</exclude>
											</excludes>
										</filter>
									</filters>
									<finalName>${xcordiaTargetName}</finalName>
									<transformers>
										<transformer
												implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
											<mainClass>${xcordiaBuildTarget}</mainClass>
										</transformer>
									</transformers>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<!-- build with `mvn -PbuildWalnut ...` to create the walnut executable JAR -->
			<id>buildWalnut</id>
			<activation>
				<property>
					<name>buildJars</name>
					<value>true</value>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-shade-plugin</artifactId>
						<executions>
							<execution>
								<id>shade-walnut</id>
								<phase>package</phase>
								<goals>
									<goal>shade</goal>
								</goals>
								<configuration>
									<filters>
										<filter>
											<artifact>*:*</artifact>
											<excludes>
												<exclude>META-INF/*.SF</exclude>
												<exclude>META-INF/*.DSA</exclude>
												<exclude>META-INF/*.RSA</exclude>
											</excludes>
										</filter>
									</filters>
									<finalName>${walnutTargetName}</finalName>
									<transformers>
										<transformer
												implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
											<mainClass>${walnutBuildTarget}</mainClass>
										</transformer>
									</transformers>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

    <dependencies>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-nop</artifactId>
